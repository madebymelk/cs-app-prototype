{
  "name": "cs-app-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "VA CCN NG Customer Service Application: high-fidelity prototype with mocked integrations. Synthetic data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "build:demo": "tsc --noEmit && vite build --mode demo --base ./ --outDir dist-demo"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.71.0",
    "react": "18.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "overrides": {
    "tldts": "7.4.19",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
